# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/rondapro

# JWT secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# JWT expiration (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# HTTP server
HOST=0.0.0.0
PORT=3000

# CORS origin for the Flutter app / web clients (* for local dev)
CORS_ORIGIN=*

# Local photo storage directory
UPLOAD_DIR=./uploads

# Optional LLM summary (OpenAI-compatible). If omitted, a heuristic summary is used.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
